# Copiar a .env en la raíz del repo (ignorado por git). mcp_server.py lo lee al arrancar.
# También vale %USERPROFILE%\.starccm-agent.env con las mismas claves.

# Clave Power-on-Demand. NUNCA en código, recetas, logs ni commits.
STARCCM_PODKEY=

# Servidor de licencias (default). Cambiar solo si Siemens indica otro.
STARCCM_LICPATH=1999@flex.cd-adapco.com

# Puerto del servidor de STAR-CCM+ y procesos paralelos (default: núcleos - 2; en este PC 4).
STARCCM_PORT=47827
# STARCCM_NP=4

# Minutos sin tools antes de guardar y apagar (PoD cobra por hora de sesión). Con GUI conectada solo avisa.
STARCCM_IDLE_MIN=30

# Carpeta de trabajo pesada, FUERA de OneDrive: sims/, macros/, residente/, tiempos.csv, .server.json, .inject.lock.
# Default: %LOCALAPPDATA%\starccm-copiloto
# COPILOTO_WORK=C:\Users\<usuario>\AppData\Local\starccm-copiloto

# Vigilante de inactividad (proceso propio por puerto, desacoplado de la CLI).
# STARCCM_VIGILANTE=1          0 = no lanzarlo (y entonces el panel no verá GUI ni inactividad)
# COPILOTO_VIGILANTE_S=30      segundos entre comprobaciones
# COPILOTO_VIG_GONE_S=3        segundos con el servidor muerto antes de que el vigilante termine
# Lanzamiento de procesos: por defecto intermediario + CREATE_NO_WINDOW. 1 = DETACHED_PROCESS (un .bat pierde la salida; solo diagnóstico).
# COPILOTO_DETACHED=0
# Registro de eventos del agente (por defecto agent.log en la raíz del repo).
# COPILOTO_AGENT_LOG=

# Cliente residente (1 = defecto, ~10x más rápido por macro; 0 = siempre el cliente batch).
# STARCCM_RESIDENT=1
# Segundos que una tool espera su turno (.inject.lock) antes de devolver busy.
# STARCCM_LOCK_WAIT_S=120
# Compilar con javac antes de inyectar (solo vía batch de respaldo).
# STARCCM_PRECOMPILE=1

# Solo si la instalación no está en C:\Program Files\Siemens\<ver>\STAR-CCM+<ver>:
# STARCCM_HOME=C:\Program Files\Siemens\19.06.009-R8\STAR-CCM+19.06.009-R8
